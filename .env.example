# =============================================================================
# TOKENS
# =============================================================================
# Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# They must differ.

# Goes on the phone, in the Health Auto Export automation's headers:
#   Authorization: Bearer <token>
# It can only POST to /api/v1/ingest — it cannot read anything.
HEALTH_INGEST_TOKEN=

# For MCP clients and the read REST API.
HEALTH_MCP_AUTH_TOKEN=

# =============================================================================
# STORAGE
# =============================================================================

# Path to the SQLite database. Created on first start.
HEALTH_DB_PATH=./health.db

# Largest single export accepted, in MB.
HEALTH_MAX_INGEST_MB=100

# =============================================================================
# MCP SERVER HTTP TRANSPORT
# =============================================================================

# "http" for the phone and remote MCP clients, "stdio" for local Claude Desktop.
HEALTH_MCP_TRANSPORT=http

# HTTP bind address and port.
HEALTH_MCP_HTTP_HOST=0.0.0.0
HEALTH_MCP_HTTP_PORT=8081

# =============================================================================
# STRAVA (optional — strava_downloader.py)
# =============================================================================
# The API application's credentials, from https://www.strava.com/settings/api
# while logged in as the athlete whose data this is. A new Strava application
# may only be connected to one athlete, so it has to be her own, not one
# already authorized by someone else. The account's email and password are
# never needed here.
#
#   1. Create the application (any name and website; Authorization Callback
#      Domain: localhost).
#   2. python strava_downloader.py --auth-url     and open the link it prints
#   3. Authorize; the browser lands on a localhost page that does not load.
#      Copy the code= value from its address.
#   4. python strava_downloader.py --authorize <code>
#
# Tokens are kept in .strava_token.json (mode 600), not in this file.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: earliest date for the first sync (YYYY-MM-DD). Unset = everything.
# STRAVA_START_DATE=2020-01-01
